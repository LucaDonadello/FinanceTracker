# Virtual environments
venv/
.env
.env.*

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# IDEs / Editors
.idea/
.vscode/
.vscode/*

# Logs, temp files
*.log
*.sqlite3
*.db
*.DS_Store

# Project notes or commands (optional)
COMMANDS.txt
notes.txt
*.docx

# Ignore the upload directory content, but keep the directory itself
app/uploads/*
!app/uploads/.gitkeep

# Ignore pytest cache
.pytest_cache/

# Ignore VS Code settings
.vscode/*
!.vscode/launch.json
!.vscode/settings.json
